# Database
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Bot username without the @ (e.g. cartrack_bot). Used to build the account-linking
# deep link https://t.me/<username>?start=<token> — linking breaks if this is unset.
TELEGRAM_BOT_USERNAME=""
CRON_SECRET="your-cron-secret-here"

# Fines API — register at https://www.parser-api.com/fines to get a key (200 free requests/month)
PARSER_API_KEY=""

# Supabase REST — from Supabase Dashboard → Settings → API.
# Server-only (no NEXT_PUBLIC_ prefix). Used by the keepalive cron to ping Supabase
# REST so the free-tier project isn't auto-paused.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY=""

# Error monitoring — GlitchTip (Sentry-compatible; the @sentry/nextjs SDK talks to
# it unchanged, only the DSN host differs — this is NOT sentry.io).
# Errors only: no tracing, no session replay, no profiling.
# Both take the same DSN value, from the GlitchTip project settings. The
# NEXT_PUBLIC_ one is exposed to the browser on purpose: a DSN is a write-only
# ingest key, it cannot read events back.
# Leave them unset locally — reporting is disabled outside production anyway.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
