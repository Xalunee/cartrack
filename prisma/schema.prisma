// ⚠️ When adding a new model: Postgres creates tables with RLS DISABLED by default.
// Supabase exposes every table in the `public` schema through its REST API, so a new
// table is publicly readable until RLS is enabled. Add an `alter table ... enable row
// level security;` statement in a migration for every new model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  password             String
  telegramChatId       String?  @unique
  telegramLinkCode     String?  @unique
  telegramLinkExpires  DateTime?
  mileageTrackInterval Int      @default(7)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  car            Car?
  supportTickets SupportTicket[]

  @@map("users")
}

/// Обращение в поддержку: тред из сообщений пользователя и ответов администратора.
/// Отдельного статуса нет — он выводится из автора последнего сообщения.
model SupportTicket {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source  String // 'web' | 'bot'
  context Json? // технические данные, собранные молча в момент обращения

  createdAt DateTime @default(now())

  messages SupportMessage[]

  @@index([userId])
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  author SupportAuthor
  text   String

  /// id сообщения в админском чате Telegram. Есть у каждого сообщения, которое
  /// там появилось — и у пересланного вопроса, и у ответа администратора: reply
  /// на любое из них должен попасть в этот же тред.
  adminMessageId String? @unique

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

enum SupportAuthor {
  USER
  ADMIN
}

model Car {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  brand          String
  model          String
  year           Int
  licensePlate   String?
  stsNumber      String?  // СТС — свидетельство о регистрации, 10 символов
  currentMileage Int      @default(0)
  lastTrackedAt  DateTime @default(now())
  lastFinesCheckAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  maintenanceItems MaintenanceItem[]
  mileageLogs      MileageLog[]
  events           CarEvent[]
  fines            Fine[]
  fuelEntries      FuelEntry[]

  @@map("cars")
}

model Fine {
  id             String    @id @default(cuid())
  carId          String
  car            Car       @relation(fields: [carId], references: [id], onDelete: Cascade)

  numPost        String    @unique // номер постановления — дедупликация
  koapCode       String?   // статья КоАП
  koapText       String?   // расшифровка
  sum            Float     // полная сумма
  enableDiscount Boolean   @default(false)
  dateDiscount   DateTime? // до какой даты скидка 50%
  dateDecision   DateTime? // дата нарушения
  divisionName   String?
  isPaid         Boolean   @default(false) // помечает пользователь
  notifiedAt     DateTime? // когда отправлено уведомление в TG
  createdAt      DateTime  @default(now())

  @@map("fines")
}

model MaintenanceItem {
  id                 String    @id @default(cuid())
  carId              String
  car                Car       @relation(fields: [carId], references: [id], onDelete: Cascade)

  name               String
  intervalKm         Int?
  intervalDays       Int?
  lastServiceMileage Int?
  lastServiceDate    DateTime?
  lastServiceCost    Float?
  lastServiceNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRecords ServiceRecord[]

  @@map("maintenance_items")
}

model ServiceRecord {
  id                String          @id @default(cuid())
  maintenanceItemId String
  maintenanceItem   MaintenanceItem @relation(fields: [maintenanceItemId], references: [id], onDelete: Cascade)

  mileage   Int
  date      DateTime
  cost      Float?
  notes     String?
  createdAt DateTime @default(now())

  @@index([maintenanceItemId])
  @@map("service_records")
}

/// Заправка. Расход считается только между двумя подряд идущими заправками
/// «до полного» — см. src/shared/lib/calculations/fuel.ts.
model FuelEntry {
  id    String @id @default(cuid())
  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  /// Одометр на момент заправки. Nullable намеренно: если на одометр не
  /// посмотрели, требование числа заставит его выдумать — а выдуманный пробег
  /// хуже пропуска. Заправка без пробега всё равно идёт в расходы, но в расчёте
  /// потребления не участвует.
  mileage Int?
  date    DateTime
  liters  Float
  /// Заплаченная сумма. Цена за литр НЕ хранится: это totalCost / liters, а
  /// третье поле — ещё одна величина, способная разойтись с двумя другими.
  totalCost Float

  /// Заправка «до полного».
  isFullTank Boolean @default(true)
  /// «Была заправка, которую я не записал» — отрезок с таким признаком
  /// исключается из расчёта, вместо того чтобы показать заниженное число.
  hasMissedEntry Boolean @default(false)

  station  String?
  fuelType String?
  /// Пока не используется: файловое хранилище сознательно не строим, но колонка
  /// есть, чтобы добавление фото не стало миграцией по живым данным.
  receiptPhotoUrl String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId, date])
  @@map("fuel_entries")
}

model MileageLog {
  id         String   @id @default(cuid())
  carId      String
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  mileage    Int
  recordedAt DateTime @default(now())
  note       String?

  @@map("mileage_logs")
}

model CarEvent {
  id          String       @id @default(cuid())
  carId       String
  car         Car          @relation(fields: [carId], references: [id], onDelete: Cascade)

  type        CarEventType
  title       String
  description String?
  cost        Float?
  occurredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@map("car_events")
}

enum CarEventType {
  ACCIDENT
  MALFUNCTION
  FINE
  SERVICE
  NOTE
}
