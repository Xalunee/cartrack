// ⚠️ When adding a new model: Postgres creates tables with RLS DISABLED by default.
// Supabase exposes every table in the `public` schema through its REST API, so a new
// table is publicly readable until RLS is enabled. Add an `alter table ... enable row
// level security;` statement in a migration for every new model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  password             String
  telegramChatId       String?  @unique
  telegramLinkCode     String?  @unique
  telegramLinkExpires  DateTime?
  mileageTrackInterval Int      @default(7)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  car Car?

  @@map("users")
}

model Car {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  brand          String
  model          String
  year           Int
  licensePlate   String?
  stsNumber      String?  // СТС — свидетельство о регистрации, 10 символов
  currentMileage Int      @default(0)
  lastTrackedAt  DateTime @default(now())
  lastFinesCheckAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  maintenanceItems MaintenanceItem[]
  mileageLogs      MileageLog[]
  events           CarEvent[]
  fines            Fine[]

  @@map("cars")
}

model Fine {
  id             String    @id @default(cuid())
  carId          String
  car            Car       @relation(fields: [carId], references: [id], onDelete: Cascade)

  numPost        String    @unique // номер постановления — дедупликация
  koapCode       String?   // статья КоАП
  koapText       String?   // расшифровка
  sum            Float     // полная сумма
  enableDiscount Boolean   @default(false)
  dateDiscount   DateTime? // до какой даты скидка 50%
  dateDecision   DateTime? // дата нарушения
  divisionName   String?
  isPaid         Boolean   @default(false) // помечает пользователь
  notifiedAt     DateTime? // когда отправлено уведомление в TG
  createdAt      DateTime  @default(now())

  @@map("fines")
}

model MaintenanceItem {
  id                 String    @id @default(cuid())
  carId              String
  car                Car       @relation(fields: [carId], references: [id], onDelete: Cascade)

  name               String
  intervalKm         Int?
  intervalDays       Int?
  lastServiceMileage Int?
  lastServiceDate    DateTime?
  lastServiceCost    Float?
  lastServiceNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRecords ServiceRecord[]

  @@map("maintenance_items")
}

model ServiceRecord {
  id                String          @id @default(cuid())
  maintenanceItemId String
  maintenanceItem   MaintenanceItem @relation(fields: [maintenanceItemId], references: [id], onDelete: Cascade)

  mileage   Int
  date      DateTime
  cost      Float?
  notes     String?
  createdAt DateTime @default(now())

  @@index([maintenanceItemId])
  @@map("service_records")
}

model MileageLog {
  id         String   @id @default(cuid())
  carId      String
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  mileage    Int
  recordedAt DateTime @default(now())
  note       String?

  @@map("mileage_logs")
}

model CarEvent {
  id          String       @id @default(cuid())
  carId       String
  car         Car          @relation(fields: [carId], references: [id], onDelete: Cascade)

  type        CarEventType
  title       String
  description String?
  cost        Float?
  occurredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@map("car_events")
}

enum CarEventType {
  ACCIDENT
  MALFUNCTION
  FINE
  SERVICE
  NOTE
}
